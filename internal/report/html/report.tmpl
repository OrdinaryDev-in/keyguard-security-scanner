<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>keyguard report: {{.Summary.Total}} finding{{if ne .Summary.Total 1}}s{{end}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <div class="brand"><span class="logo" aria-hidden="true">◆</span> keyguard <span class="ver">v{{.Version}}</span></div>
    <h1>Security scan report</h1>
    <dl class="meta">
      <div><dt>Project</dt><dd><code>{{.Root}}</code></dd></div>
      <div><dt>Scanned</dt><dd>{{.When}}</dd></div>
      <div><dt>Coverage</dt><dd>{{.FilesScanned}} files{{if .History}}, {{.Commits}} commits{{else}}, history not scanned{{end}}</dd></div>
      <div><dt>Duration</dt><dd>{{.DurationMS}} ms</dd></div>
    </dl>
  </div>
</header>

<main class="wrap">
  <section class="summary" aria-label="Summary">
    <div class="card total {{if .Summary.Total}}bad{{else}}good{{end}}">
      <span class="num">{{.Summary.Total}}</span>
      <span class="lbl">{{if .Summary.Total}}finding{{if ne .Summary.Total 1}}s{{end}} to review{{else}}No findings{{end}}</span>
    </div>
    <div class="card sev-high"><span class="num">{{.Summary.High}}</span><span class="lbl">High</span></div>
    <div class="card sev-medium"><span class="num">{{.Summary.Medium}}</span><span class="lbl">Medium</span></div>
    <div class="card sev-low"><span class="num">{{.Summary.Low}}</span><span class="lbl">Low</span></div>
  </section>

  {{if .Findings}}
  <section class="toolbar" id="toolbar" aria-label="Filters" hidden>
    <div class="chips" role="group" aria-label="Severity">
      <button type="button" class="chip" data-sev="high" aria-pressed="true">High</button>
      <button type="button" class="chip" data-sev="medium" aria-pressed="true">Medium</button>
      <button type="button" class="chip" data-sev="low" aria-pressed="true">Low</button>
    </div>
    <label class="field"><span class="sr-only">Rule</span>
      <select id="rule-filter">
        <option value="">All rules</option>
        {{range .RuleIDs}}<option value="{{.}}">{{.}}</option>{{end}}
      </select>
    </label>
    <label class="field grow"><span class="sr-only">Search files and descriptions</span>
      <input id="search" type="search" placeholder="Search file or description…" autocomplete="off">
    </label>
    <button type="button" class="link" id="toggle-all">Expand all</button>
  </section>
  <p class="status" id="status" role="status" aria-live="polite"></p>
  <p class="empty-filter" id="empty-filter" hidden>No findings match these filters.</p>

  {{range .Groups}}
  <section class="group" data-group="{{.Key}}">
    <h2>{{.Title}} <span class="count">{{len .Findings}}</span></h2>
    <p class="blurb">{{.Blurb}}</p>
    <div class="list">
    {{range .Findings}}
      <details class="finding" data-sev="{{.Severity}}" data-rule="{{.RuleID}}" data-text="{{lower .File}} {{lower .Description}}">
        <summary>
          <span class="badge {{.Severity}}">{{upper .Severity.String}}</span>
          <span class="what">
            <span class="desc">{{.Description}}</span>
            <span class="where"><code>{{.File}}{{if .Line}}:{{.Line}}{{end}}</code>{{if .Secret}} <code class="secret" title="Redacted">{{.Secret}}</code>{{end}}</span>
          </span>
          <span class="chev" aria-hidden="true"></span>
        </summary>
        <div class="body">
          {{with .Commit}}
          <p class="commit">Introduced in <code>{{short .SHA 8}}</code> by {{.Author}} on {{short .Date 10}}.
            {{if .InWorkingTree}}<strong>Still in current files.</strong>{{else}}<strong>Removed from current files, but still in history.</strong>{{end}}</p>
          {{end}}
          {{if .Context}}
          <pre class="code" tabindex="0" role="group" aria-label="Code around the finding (secrets redacted)">{{range .Context}}<span class="ln{{if .Hit}} hit{{end}}"><span class="n">{{.Number}}</span>{{if .Hit}}<span class="sr-only">Flagged line: </span>{{end}}{{.Text}}</span>{{end}}</pre>
          {{end}}
          <div class="fix"><h3>How to fix</h3><p>{{.Fix}}</p></div>
          <p class="rule">Rule <code>{{.RuleID}}</code>{{if .Column}} · column {{.Column}}{{end}}</p>
        </div>
      </details>
    {{end}}
    </div>
  </section>
  {{end}}
  {{else}}
  <section class="clean">
    <div class="tick" aria-hidden="true">✓</div>
    <h2>No secrets or risky configuration found</h2>
    <p>{{if not .History}}Tip: run with <code>--history</code> to also check every past commit.{{else}}Working tree and git history are clean.{{end}}</p>
  </section>
  {{end}}

  <footer class="foot">
    Secret values are redacted in this report. Generated by keyguard v{{.Version}}. Add <code>// keyguard:ignore</code> on a line to accept a known false positive.
  </footer>
</main>
<script>{{.JS}}</script>
</body>
</html>
